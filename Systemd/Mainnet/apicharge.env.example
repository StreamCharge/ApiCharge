# ApiCharge Environment Configuration (Mainnet)
# Copy this file to /etc/apicharge/apicharge.env and fill in your values
#
# IMPORTANT: This file contains secrets. Protect it accordingly:
#   chmod 600 /etc/apicharge/apicharge.env
#   chown apicharge:apicharge /etc/apicharge/apicharge.env

# Stellar signing key (required)
# Your Stellar secret key starting with 'S'
APICHARGE_SIGNING_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Network passphrase (do not change for mainnet)
APICHARGE_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015
